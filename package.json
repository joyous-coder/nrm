{
  "name": "@joyous-coder/nrm",
  "version": "2.1.4",
  "description": "npm registry manager — Pana/nrm fork that fixes the npmrc _auth leak: switching registries no longer writes `_auth`, `always-auth`, `email`, `repository`, or `home` to the top level of ~/.npmrc",
  "bin": {
    "nrm": "dist/index.js"
  },
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joyous-coder/nrm.git",
    "directory": "."
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf node_modules dist",
    "test": "pnpm build && vitest run",
    "dev": "tsc --watch",
    "build": "rimraf dist && tsc && rimraf dist/types.js",
    "test:watch": "vitest",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "check": "biome check --write --verbose"
  },
  "keywords": [
    "npm",
    "registry",
    "nrm",
    "npmrc",
    "patch",
    "fork"
  ],
  "author": {
    "name": "joyous-coder",
    "url": "https://github.com/joyous-coder/nrm"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/joyous-coder/nrm/issues"
  },
  "homepage": "https://github.com/joyous-coder/nrm#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@inquirer/checkbox": "^4.0.3",
    "@inquirer/select": "^4.0.2",
    "chalk": "4.1.2",
    "commander": "^8.3.0",
    "ini": "4.1.3",
    "open": "8.4.2",
    "undici": "5.28.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.27.8",
    "@types/ini": "^4.1.1",
    "@types/node": "18",
    "coffee": "^5.4.0",
    "mock-fs": "^5.4.1",
    "rimraf": "^6.0.1",
    "strip-ansi": "^7.1.0",
    "typescript": "^5.7.2",
    "vitest": "2.1.6"
  },
  "engines": {
    "node": ">=18"
  }
}
